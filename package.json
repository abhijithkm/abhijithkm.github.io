    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.18.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
